{
  "_comment": "对外服务门户的服务清单示例。复制成 services.json 后按需修改（本文件在仓库里，不在 npm 包里）。",
  "_howToUse": "python -X utf8 tools/start_public_gui.py --services <本文件路径> --single-domain",
  "_hostRepoNote": "hostRepo 必须改成你自己的宿主仓库根（被开放的服务本体所在目录）。这里不预置任何人的本机路径。",
  "hostRepo": "C:\\path\\to\\your\\host-repo",
  "services": [
    {
      "key": "train",
      "script": "gui/server.py",
      "guiPort": 8810,
      "proxyPort": 8890,
      "name": "训练配置台",
      "mount": "train"
    },
    {
      "key": "viewer",
      "script": "gui/viewer_server.py",
      "guiPort": 8811,
      "proxyPort": 8891,
      "name": "模型查看台",
      "mount": "viewer"
    }
  ]
}
